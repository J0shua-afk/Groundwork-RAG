ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Supabase "Session pooler" connection strings (Connect button in the dashboard), one per project
PRIVATE_DATABASE_URL=
PUBLIC_DATABASE_URL=

# the database the API reads. locally: either session pooler URL above. on Vercel: the public
# project's transaction pooler (port 6543) as the read-only groundwork_api role
DATABASE_URL=

# optional, for `pytest -m integration`. writes are rolled back, but point it at the public project
TEST_DATABASE_URL=
# optional: the groundwork_api role's URL, so a test can prove it can read but not write
API_DATABASE_URL=
